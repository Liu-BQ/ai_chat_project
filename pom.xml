<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程信息 -->
    <groupId>com.lbq</groupId>
    <artifactId>ai-chat-project</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging> <!-- 关键：必须是 pom -->

    <name>AI Chat Project</name>
    <description>Modular AI Chat with Ollama</description>

    <properties>
        <!-- Java 版本配置 -->
        <java.version>21</java.version>
        <!-- Maven 编译器源码版本 -->
        <maven.compiler.source>21</maven.compiler.source>
        <!-- Maven 编译器目标版本 -->
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Maven 编译器发布版本 -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Spring Boot 框架版本 -->
        <spring-boot.version>4.0.1</spring-boot.version>
        <!-- MapStruct 映射工具版本 -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <!-- Lombok 注解工具版本 -->
        <lombok.version>1.18.30</lombok.version>
        <!-- 项目构建源码编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <!-- 声明子模块 -->
    <modules>
        <module>model-app</module>
        <module>model-ollama-client</module>
        <module>model-persistence</module>
        <module>model-web-api</module>
        <module>model-common</module>
    </modules>

    <!-- 所有子模块都会自动继承这些依赖 -->
    <dependencies>
        <!-- 通用开发工具（所有模块都需要） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 统一依赖版本管理 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 插件管理 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>